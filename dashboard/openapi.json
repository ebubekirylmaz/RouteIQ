          },
          "delivery": {
            "$ref": "#/components/schemas/DeliveryCounts"
          },
          "human_review": {
            "title": "Human Review",
            "type": "integer"
          },
          "latency_ms": {
            "$ref": "#/components/schemas/LatencyStats"
          },
          "requests": {
            "title": "Requests",
            "type": "integer"
          },
          "review": {
            "$ref": "#/components/schemas/ReviewCounts"
          },
          "reviewer_agreement": {
            "$ref": "#/components/schemas/ReviewerAgreement"
          }
        },
        "required": [
