          },
          "avg_latency_ms": {
            "title": "Avg Latency Ms",
            "type": "number"
          },
          "cost_usd": {
            "title": "Cost Usd",
            "type": "number"
          },
          "human_review": {
            "title": "Human Review",
            "type": "integer"
          },
          "requests": {
            "title": "Requests",
            "type": "integer"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "start",
          "requests",
          "accepted",
          "human_review",
          "cost_usd",
          "avg_latency_ms"
        ],
        "title": "TimeseriesPoint",
        "type": "object"
