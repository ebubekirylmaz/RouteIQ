          },
          "rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Share of human-reviewed requests where the reviewer kept the model's suggestion. Only requests the model was unsure about are reviewed, so this is NOT the model's overall accuracy.",
            "title": "Rate"
          },
          "resolved": {
            "title": "Resolved",
            "type": "integer"
          }
        },
        "required": [
          "resolved",
          "agreed",
          "rate"
        ],
        "title": "ReviewerAgreement",
        "type": "object"
      },
      "RouteRequest": {
        "properties": {
