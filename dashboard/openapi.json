          "human_review",
          "reviewer_agreement",
          "review",
          "degraded",
          "cost_usd",
          "latency_ms",
          "delivery"
        ],
        "title": "StatsResponse",
        "type": "object"
      },
      "TierInfo": {
        "properties": {
          "accept_threshold": {
